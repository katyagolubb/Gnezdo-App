{
  "version": 3,
  "endpoints": [

    {
      "endpoint": "/api/register",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Content-Type"],
      "backend": [
        {
          "url_pattern": "/api/register/",
          "host": ["http://user-management-api:5001"],
          "method": "POST"
        }
      ]
    },


    {
      "endpoint": "/api/token",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Content-Type"],
      "backend": [
        {
          "url_pattern": "/api/token/",
          "host": ["http://user-management-api:5001"],
          "method": "POST"
        }
      ]
    },


    {
      "endpoint": "/api/token/refresh",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Content-Type"],
      "backend": [
        {
          "url_pattern": "/api/token/refresh/",
          "host": ["http://user-management-api:5001"],
          "method": "POST"
        }
      ]
    },


    {
      "endpoint": "/api/me",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/api/me/",
          "host": ["http://user-management-api:5001"],
          "method": "GET"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "jwk_url": "http://user-management-api:5001/jwks"
        }
      }
    },

    {
      "endpoint": "/api/update",
      "method": "PUT",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [
        {
          "url_pattern": "/api/update/",
          "host": ["http://user-management-api:5001"],
          "method": "PUT"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "jwk_url": "http://user-management-api:5001/jwks"
        }
      }
    },


    {
      "endpoint": "/api/delete",
      "method": "DELETE",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/api/delete/",
          "host": ["http://user-management-api:5001"],
          "method": "DELETE"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "jwk_url": "http://user-management-api:5001/jwks"
        }
      }
    },


    {
      "endpoint": "/api/password-reset",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/password-reset/",
          "host": ["http://user-management-api:5001"],
          "method": "POST"
        }
      ]
    },


    {
      "endpoint": "/api/password-reset/confirm",
      "method": "POST",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/api/password-reset/confirm/",
          "host": ["http://user-management-api:5001"],
          "method": "POST"
        }
      ]
    },


    {
      "endpoint": "/api/users/{id}",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization"],
      "backend": [
        {
          "url_pattern": "/api/users/{id}/",
          "host": ["http://user-management-api:5001"],
          "method": "GET"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "jwk_url": "http://user-management-api:5001/jwks"
        }
      }
    }
  ],
  "extra_config": {
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE"],
      "allow_headers": ["Authorization", "Content-Type"]
    }
  }
}